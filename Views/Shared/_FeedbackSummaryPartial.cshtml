@model FeedbackManagementDemo.Models.FeedbackSummaryViewModel

<fieldset>
    <legend><strong>Feedback Summary (Rendered via Partial View: _FeedbackSummaryPartial.cshtml)</strong></legend>
    <ul>
        <li><strong>Total Feedbacks Received:</strong> @Model.TotalFeedbacks</li>
        <li><strong>Average Rating:</strong> @Model.AverageRating / 5</li>
        <li><strong>Bug Reports:</strong> @Model.BugReportsCount</li>
        <li><strong>Feature Requests:</strong> @Model.FeatureRequestsCount</li>
        <li><strong>General Feedbacks:</strong> @Model.GeneralFeedbackCount</li>
    </ul>
</fieldset>
