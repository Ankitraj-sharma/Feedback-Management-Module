<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feedback Management</title>
</head>
<body>
    <header>
        <h2>Feedback Management</h2>
        <nav>
            <a asp-controller="Feedback" asp-action="Index">All Feedback</a> |
            <a asp-controller="Feedback" asp-action="Create">Submit Feedback</a>
        </nav>
    </header>

    <hr />

    <main role="main">
        @RenderBody()
    </main>

    <hr />

    <footer>
        <p>
            Practical 7 | ASP.NET MVC Layout, Partial View &amp; Validation (Demo - No CSS)<br />
            Ankit raj sharma | Feedback Management Module
        </p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
