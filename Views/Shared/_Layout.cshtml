<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feedback Management System</title>
</head>
<body>
    <header>
        <h2>Feedback Management System</h2>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a> |
            <a asp-controller="Feedback" asp-action="Index">Feedback List</a> |
            <a asp-controller="Feedback" asp-action="Create">Submit Feedback</a>
        </nav>
    </header>

    <hr />

    <main role="main">
        @RenderBody()
    </main>

    <hr />

    <footer>
        <p>&copy; @DateTime.UtcNow.Year - Feedback Management System Demo (MVC Layout, Partial View & Validation)</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
