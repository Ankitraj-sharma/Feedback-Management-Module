@model FeedbackManagementDemo.Models.Feedback

<fieldset>
    <legend><strong>Feedback Details (Rendered via Partial View: _FeedbackDetailsPartial.cshtml)</strong></legend>
    <dl>
        <dt><strong>Feedback ID:</strong></dt>
        <dd>@Model.Id</dd>

        <dt><strong>Full Name:</strong></dt>
        <dd>@Model.FullName</dd>

        <dt><strong>Email:</strong></dt>
        <dd>@Model.Email</dd>

        <dt><strong>Category:</strong></dt>
        <dd>@Model.Category</dd>

        <dt><strong>Rating:</strong></dt>
        <dd>@Model.Rating / 5</dd>

        <dt><strong>Comments:</strong></dt>
        <dd>@Model.Comments</dd>

        <dt><strong>Subscribe to Updates:</strong></dt>
        <dd>@(Model.SubscribeToUpdates ? "Yes" : "No")</dd>

        <dt><strong>Submitted At:</strong></dt>
        <dd>@Model.SubmittedAt.ToLocalTime().ToString("f")</dd>
    </dl>
</fieldset>
