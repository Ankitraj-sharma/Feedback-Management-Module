@model List<FeedbackManagementDemo.Models.Feedback>

@{
    ViewData["Title"] = "All Feedback";
}

<h1>All Feedback</h1>
<p>Review the feedback submitted in this session.</p>

<p>
    <a asp-action="Create"><strong>[ + Submit Feedback ]</strong></a>
</p>

@if (TempData["Success"] != null)
{
    <div>
        <strong>Success:</strong> @TempData["Success"]
    </div>
    <br />
}

<p><strong>Total Feedback: @Model.Count</strong></p>

@if (Model == null || !Model.Any())
{
    <p>No feedback yet. Submit your first feedback.</p>
}
else
{
    foreach (var feedback in Model)
    {
        <!-- Demonstration of Partial View -->
        <partial name="_FeedbackCard" model="feedback" />
    }
}
