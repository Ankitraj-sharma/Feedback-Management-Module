@model FeedbackManagementDemo.Models.Feedback

@{
    ViewData["Title"] = "Submit Feedback";
}

<h1>Submit Feedback</h1>
<p>Share your learning experience. All fields are required.</p>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"></div>

    <fieldset>
        <legend>Feedback Form</legend>

        <p>
            <label asp-for="StudentName"></label><br />
            <input asp-for="StudentName" size="50" maxlength="60" />
            <br />
            <span asp-validation-for="StudentName"></span>
        </p>

        <p>
            <label asp-for="Email"></label><br />
            <input asp-for="Email" size="50" maxlength="100" type="email" />
            <br />
            <span asp-validation-for="Email"></span>
        </p>

        <p>
            <label asp-for="Subject"></label><br />
            <input asp-for="Subject" size="50" maxlength="80" />
            <br />
            <span asp-validation-for="Subject"></span>
        </p>

        <p>
            <label asp-for="Rating"></label><br />
            <select asp-for="Rating">
                <option value="">-- Select rating --</option>
                <option value="1">1 / 5</option>
                <option value="2">2 / 5</option>
                <option value="3">3 / 5</option>
                <option value="4">4 / 5</option>
                <option value="5">5 / 5</option>
            </select>
            <br />
            <span asp-validation-for="Rating"></span>
        </p>

        <p>
            <label asp-for="Comments"></label><br />
            <textarea asp-for="Comments" rows="4" cols="50" maxlength="500"></textarea>
            <br />
            <span asp-validation-for="Comments"></span>
        </p>

        <p>
            <button type="submit">Submit Feedback</button>
            <a asp-action="Index">View Feedback</a>
        </p>
    </fieldset>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
